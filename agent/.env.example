TIMEZONE=Europe/Madrid
NAS_IP=nas.home.lab
NAS_BACKUP_SHARE=backups
NAS_BACKUP_USER=
NAS_BACKUP_PASSWORD=
HERMES_API_KEY=
HERMES_WORKSPACE_PASSWORD=

# Home Agent (dedicated Telegram bot; do not reuse Hermes' token)
# Set COMPOSE_PROFILES=home-agent only after every value below is configured.
COMPOSE_PROFILES=
HOME_AGENT_TELEGRAM_BOT_TOKEN=
HOME_AGENT_TELEGRAM_USER_ID=
HOME_AGENT_TELEGRAM_CHAT_ID=
HOME_AGENT_CLIPROXYAPI_API_KEY=
HOME_AGENT_PI_MODEL_ID=gpt-5.6-terra
HOME_AGENT_PI_THINKING_LEVEL=medium
HOME_AGENT_MQTT_USERNAME=
HOME_AGENT_MQTT_PASSWORD=
# Base64-encoded GitHub deploy key with write access to my-esphome.
HOME_AGENT_GIT_DEPLOY_KEY_B64=

# Agent Inbox (the image commit is pinned in docker-compose.yml)
# Connector token for the dedicated milverds tunnel, which publishes
# ingest-agents.milverds.com to agent-inbox and nothing else.
MILVERDS_TUNNEL_TOKEN=
AGENT_INBOX_INGEST_TOKEN=
AGENT_INBOX_INBOX_ADDRESS=inbox@agents.milverds.com
AGENT_INBOX_AUTHORIZED_SENDER=marc@milverds.com
AGENT_INBOX_DKIM_DOMAIN=milverds.com
