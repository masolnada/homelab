{
	email {$ACME_EMAIL}
}

# Agent Inbox is not routed here. Caddy only listens on the Tailscale address,
# but the Cloudflare Email Worker calls it from the public internet, so
# ingest-agents.milverds.com is published through the cloudflared tunnel
# instead — same pattern as share.{$DOMAIN}. See README.

*.{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers nina.ns.cloudflare.com randy.ns.cloudflare.com
		propagation_delay 60s
	}

	@vault host vault.{$DOMAIN}
	handle @vault {
		reverse_proxy vaultwarden:80
	}

	@music host music.{$DOMAIN}
	handle @music {
		reverse_proxy navidrome:4533
	}

	@contacts host contacts.{$DOMAIN}
	handle @contacts {
		reverse_proxy radicale:5232
	}

	@notes host notes.{$DOMAIN}
	handle @notes {
		reverse_proxy silverbullet:3000
	}

	@webdav host webdav.{$DOMAIN}
	handle @webdav {
		reverse_proxy webdav:6065
	}

	@photos host photos.{$DOMAIN}
	handle @photos {
		reverse_proxy immich-server:2283
	}

	@share host share.{$DOMAIN}
	handle @share {
		reverse_proxy immich-public-proxy:3000
	}

	@home host home.{$DOMAIN}
	handle @home {
		reverse_proxy homepage:3000
	}

	@hermes host hermes.{$DOMAIN}
	handle @hermes {
		reverse_proxy hermes:9119
	}

	@workspace host workspace.{$DOMAIN}
	handle @workspace {
		reverse_proxy hermes-workspace:3000
	}

	@cpa host cpa.{$DOMAIN}
	handle @cpa {
		reverse_proxy cli-proxy-api:8317
	}

	@cpamp host cpamp.{$DOMAIN}
	handle @cpamp {
		reverse_proxy cpa-manager-plus:18317
	}

	@mqtt host mqtt.{$DOMAIN}
	handle @mqtt {
		reverse_proxy mosquitto:9001
	}

	@esphome host esphome.{$DOMAIN}
	handle @esphome {
		reverse_proxy esphome:6052
	}

	@z2m-baixos host z2m-baixos.{$DOMAIN}
	handle @z2m-baixos {
		reverse_proxy z2m-baixos:8080
	}

	@z2m-pis host z2m-pis.{$DOMAIN}
	handle @z2m-pis {
		reverse_proxy z2m-pis:8080
	}

	@grafana host grafana.{$DOMAIN}
	handle @grafana {
		reverse_proxy grafana:3000
	}

	@gatus host gatus.{$DOMAIN}
	handle @gatus {
		reverse_proxy gatus:8080
	}

	# Read-only browsing of the local image registry. Pushes and pulls do not go
	# through here — the Docker daemon uses 127.0.0.1:5000 directly — so anything
	# that mutates state is rejected.
	@registry host registry.{$DOMAIN}
	handle @registry {
		@registry-write not method GET HEAD OPTIONS
		respond @registry-write 405
		reverse_proxy zot:5000
	}

	handle {
		abort
	}
}
