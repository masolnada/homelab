TIMEZONE=Europe/Madrid

# CPAMP -> CPA management API (must match secret-key in config.yaml, plaintext)
CPA_MANAGEMENT_KEY=

# CPA Manager Plus full-mode login (cpamp.<domain>)
CPA_MANAGER_ADMIN_KEY=

# 9Router dashboard (9router.<domain>)
NINEROUTER_JWT_SECRET=
NINEROUTER_INITIAL_PASSWORD=

# TrueNAS CIFS backup target
NAS_IP=nas.home.lab
NAS_BACKUP_SHARE=backups
NAS_BACKUP_USER=
NAS_BACKUP_PASSWORD=
