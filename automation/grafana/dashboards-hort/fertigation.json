  "annotations": {
    "list": []
  },
  "description": "YF-B5 flow sensor \u2014 water used per configurable interval, range total, time since last watering, and device warnings/errors.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-zigbee"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none"
          },
          "unit": "litre"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 2,
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-zigbee"
          },
          "query": "selected = \"${water_interval}\"\ninterval =\n  if selected == \"15m\" then 15m\n  else if selected == \"1h\" then 1h\n  else if selected == \"6h\" then 6h\n  else if selected == \"1d\" then 1d\n  else if selected == \"7d\" then 7d\n  else 1h\nfrom(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"esphome_sensor\")\n  |> filter(fn: (r) => r.entity == \"total_water\" and r._field == \"value\")\n  |> sort(columns: [\"_time\"])\n  |> difference(nonNegative: true)\n  |> aggregateWindow(every: interval, fn: sum, createEmpty: true)\n  |> fill(column: \"_value\", value: 0.0)",
          "refId": "A"
        }
      ],
      "title": "Water used per interval",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-zigbee"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "black"
          },
          "unit": "litre",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "black",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-zigbee"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"esphome_sensor\")\n  |> filter(fn: (r) => r.entity == \"total_water\" and r._field == \"value\")\n  |> sort(columns: [\"_time\"])\n  |> difference(nonNegative: true)\n  |> sum()",
          "refId": "A"
        }
      ],
      "title": "Water used (selected range)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-zigbee"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "dtdurationms",
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-zigbee"
          },
          "query": "last = from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"esphome_sensor\")\n  |> filter(fn: (r) => r.entity == \"total_water\" and r._field == \"value\")\n  |> sort(columns: [\"_time\"])\n  |> difference(nonNegative: true)\n  |> filter(fn: (r) => r._value > 0.0)\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000.0}))\n  |> keep(columns: [\"_time\", \"_value\"])\nlast",
          "refId": "A"
        }
      ],
      "title": "Time since last watering",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-zigbee"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "error": {
                        "color": "red",
                        "index": 0,
                        "text": "error"
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1,
                        "text": "warning"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "_time"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-zigbee"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"esphome_event\" and r._field == \"value\")\n  |> filter(fn: (r) =>\n    (r.topic == \"kc868-a8/flow/dry_run\") or\n    (r.topic == \"kc868-a8/flow/reset_total/result\" and (r._value == \"error_persistence\" or r._value == \"rejected_pump_running\" or r._value == \"rejected_flow_active\" or r._value == \"rejected_flow_unknown\")) or\n    (r.topic == \"kc868-a8/status\" and r._value == \"offline\"))\n  |> map(fn: (r) => ({r with\n    severity: if r.topic == \"kc868-a8/flow/dry_run\" or r._value == \"error_persistence\" or (r.topic == \"kc868-a8/status\" and r._value == \"offline\") then \"error\" else \"warning\",\n    event: if r.topic == \"kc868-a8/flow/dry_run\" then \"dry-run shutdown\" else if r.topic == \"kc868-a8/status\" then \"device offline\" else \"total-water reset\",\n    reason: r._value\n  }))\n  |> keep(columns: [\"_time\", \"severity\", \"event\", \"reason\"])\n  |> sort(columns: [\"_time\"], desc: true)",
          "refId": "A"
        }
      ],
      "title": "Errors and warnings",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "hort"
  ],
  "templating": {
    "list": [
      {
        "name": "water_interval",
        "label": "Water interval",
        "type": "custom",
        "hide": 0,
        "query": "15m,1h,6h,1d,7d",
        "definition": "15m,1h,6h,1d,7d",
